<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <gazebo>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"/>
    <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find scout_description)/config/$(arg controller_file)</parameters>
      <robot_param>robot_description</robot_param>
      <ros>
        <namespace>$(arg namespace)</namespace>
      </ros>
    </plugin>
  </gazebo>

  <xacro:property name="topic_prefix" value="/"/>
  <xacro:if value="${'$(arg namespace)' != ''}">
    <xacro:property name="topic_prefix" value="/$(arg namespace)/"/>
  </xacro:if>

  <xacro:property name="frame_prefix" value=""/>
  <xacro:if value="${'$(arg namespace)' != ''}">
    <xacro:property name="frame_prefix" value="$(arg namespace)/"/>
  </xacro:if>

  <gazebo reference="laser_link">
    <sensor name="helios_lidar" type="gpu_lidar">
      <gz_frame_id>${frame_prefix}laser_link</gz_frame_id>
      <pose>0 0 0.05 0 0 0</pose>
      <topic>${topic_prefix}lidar</topic>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <lidar>
        <scan>
          <horizontal>
            <!-- ~0.2° resolution -->
            <samples>${360/0.2}</samples>
            <resolution>1</resolution>
            <min_angle>${-M_PI}</min_angle>
            <max_angle>${M_PI}</max_angle>
          </horizontal>
          <vertical>
            <samples>16</samples>
            <resolution>1</resolution>
            <min_angle>${-(M_PI/(180/15))}</min_angle>
            <max_angle>${(M_PI/(180/15))}</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.2</min>
          <max>150</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <!-- ±2 cm accuracy -->
          <stddev>0.02</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <gazebo reference="d435_camera_color_frame">
    <sensor name="rgb_camera" type="camera">
      <gz_frame_id>${frame_prefix}d435_camera_color_optical_frame</gz_frame_id>
      <pose>0 0 0 0 0 0</pose>
      <topic>${topic_prefix}d435_camera/color/image_raw</topic>
      <update_rate>30</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <camera>
        <horizontal_fov>${M_PI/(180/69.4)}</horizontal_fov>
        <image>
          <width>${1280/$(arg sim_reduction)}</width>
          <height>${800/$(arg sim_reduction)}</height>
          <width>128</width>
          <height>80</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.105</near>
          <far>10</far>
        </clip>
        <noise type="gaussian">
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
        <distortion>
          <k1>0.0</k1>
          <k2>0.0</k2>
          <k3>0.0</k3>
          <p1>0.0</p1>
          <p2>0.0</p2>
        </distortion>
      </camera>
    </sensor>
  </gazebo>

  <gazebo reference="d435_camera_depth_frame">
    <sensor name="depth_camera" type="depth_camera">
      <gz_frame_id>${frame_prefix}d435_camera_depth_optical_frame</gz_frame_id>
      <pose>0 0 0 0 0 0</pose>
      <topic>${topic_prefix}d435_camera/depth/image_raw</topic>
      <update_rate>90</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <camera>
        <horizontal_fov>${M_PI/(180/86)}</horizontal_fov>
        <image>
          <width>${1280/$(arg sim_reduction)}</width>
          <height>${720/$(arg sim_reduction)}</height>
        </image>
        <clip>
          <near>0.105</near>
          <far>10</far>
        </clip>
        <noise type="gaussian">
          <mean>0.0</mean>
          <stddev>0.005</stddev>
        </noise>
        <distortion>
          <k1>0.0</k1>
          <k2>0.0</k2>
          <k3>0.0</k3>
          <p1>0.0</p1>
          <p2>0.0</p2>
        </distortion>
      </camera>
    </sensor>
  </gazebo>

  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <gz_frame_id>${frame_prefix}imu_link</gz_frame_id>
      <pose>0 0 0 0 0 0</pose>
      <topic>${topic_prefix}imu/data</topic>
      <update_rate>100</update_rate>
      <always_on>true</always_on>
      <imu>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <!-- 0.08 °/s/√Hz * √100 = 0.8 °/s → rad/s -->
              <stddev>0.01396</stddev>
              <bias_mean>0.0</bias_mean>
              <!-- 10 °/h bias stability → rad/s -->
              <bias_stddev>0.00004848</bias_stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.01396</stddev>
              <bias_mean>0.0</bias_mean>
              <bias_stddev>0.00004848</bias_stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.01396</stddev>
              <bias_mean>0.0</bias_mean>
              <bias_stddev>0.00004848</bias_stddev>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <!-- 120 μg/√Hz * √100 = 0.0012 g → m/s² (g=9.81) -->
              <stddev>0.01177</stddev>
              <bias_mean>0.0</bias_mean>
              <!-- 30 mG bias stability = 0.03 g → m/s² -->
              <bias_stddev>0.2943</bias_stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.01177</stddev>
              <bias_mean>0.0</bias_mean>
              <bias_stddev>0.2943</bias_stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.01177</stddev>
              <bias_mean>0.0</bias_mean>
              <bias_stddev>0.2943</bias_stddev>
            </noise>
          </z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <gazebo reference="imu_link">
    <sensor name="magnetometer" type="magnetometer">
      <gz_frame_id>${frame_prefix}imu_link</gz_frame_id>
      <pose>0 0 0 0 0 0</pose>
      <topic>${topic_prefix}imu/mag</topic>
      <update_rate>100</update_rate>
      <always_on>true</always_on>
      <magnetometer>
        <x>
          <noise type="gaussian">
            <mean>0.0</mean>
            <!-- Approx. based on 0.25 mG resolution / 2 → T (1 G = 10^{-4} T) -->
            <stddev>0.0000000125</stddev>
          </noise>
        </x>
        <y>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>0.0000000125</stddev>
          </noise>
        </y>
        <z>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>0.0000000125</stddev>
          </noise>
        </z>
      </magnetometer>
    </sensor>
  </gazebo>

  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="front_left_wheel">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rear_left_wheel">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="front_right_wheel">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rear_right_wheel">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>
</robot>
